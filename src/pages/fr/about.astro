---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TimelineItem from '../../components/TimelineItem.astro';
import MorseMark from '../../components/MorseMark.astro';
import { t, getLocalePath } from '../../i18n/utils';

const lang = 'fr';
const tr = t(lang);
const about = tr.about;
---

<BaseLayout
  lang={lang}
  title={about.title}
  description="Banconlé AKOBI : ingénieur 4e année INSA Hauts-de-France, IT Manager, fondateur de LanceOS. Cybersécurité, développement, éloquence."
>
  <PageHero eyebrow={about.subtitle} title={about.title} signature="parcours" />

  <!-- BIO -->
  <section class="om-section om-bio">
    <div class="om-bio__media gsap-reveal">
      <div class="om-frame om-frame--portrait">
        <img
          src="/images/profile.jpg"
          alt={tr.hero.portrait_alt}
          width="1080"
          height="1440"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>

    <div class="om-bio__text">
      <h2 class="om-bio__name gsap-reveal">{tr.hero.name}</h2>
      {about.bio.split('\n\n').map((para: string) => (
        <p class="om-bio__para gsap-reveal">{para}</p>
      ))}
      <div class="om-bio__actions gsap-reveal">
        <a href={getLocalePath(lang, '/contact')} class="om-btn">
          Me contacter
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href="https://www.linkedin.com/in/banconl%C3%A9-akobi-a88940273"
          class="om-btn--ghost"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <!-- PARCOURS -->
  <section class="om-section">
    <div class="om-rule om-head gsap-reveal">
      <h2 class="om-head__title">{about.timeline_title}</h2>
      <span class="om-rule__line" aria-hidden="true"></span>
      <MorseMark word={about.timeline_title} />
    </div>
    <ol class="om-timeline gsap-stagger">
      {about.timeline.map((item, i) => (
        <TimelineItem date={item.date} title={item.title} place={item.place} desc={item.desc} index={i} />
      ))}
    </ol>
  </section>

  <!-- VALEURS -->
  <section class="om-section">
    <div class="om-rule om-head gsap-reveal">
      <h2 class="om-head__title">{about.values_title}</h2>
      <span class="om-rule__line" aria-hidden="true"></span>
      <MorseMark word="valeurs" />
    </div>
    <ul class="om-values gsap-stagger">
      {about.values.map((value) => (
        <li class="om-values__card gsap-item">
          <MorseMark word={value.title} class="om-values__morse" />
          <h3 class="om-values__title">{value.title}</h3>
          <p class="om-values__desc">{value.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- CERTIFICATIONS -->
  <section class="om-section">
    <div class="om-rule om-head gsap-reveal">
      <h2 class="om-head__title">{about.certifications_title}</h2>
      <span class="om-rule__line" aria-hidden="true"></span>
      <MorseMark word="preuves" />
    </div>
    <ul class="om-certs gsap-stagger">
      {about.certifications.map((cert: string) => (
        <li class="om-certs__item gsap-item">
          <span class="om-certs__bullet" aria-hidden="true"></span>
          <span>{cert}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .om-head {
    margin-bottom: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .om-head__title {
    margin: 0;
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    line-height: 1;
    flex: 0 0 auto;
  }

  /* --- Bio --- */
  .om-bio {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  .om-bio__media { max-width: 24rem; }

  .om-bio__name {
    margin: 0 0 1.25rem;
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    line-height: 1;
  }

  .om-bio__para {
    margin: 0 0 1rem;
    max-width: 62ch;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .om-bio__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  /* --- Parcours --- */
  .om-timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- Valeurs --- */
  .om-values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: clamp(0.875rem, 2vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .om-values__card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    border: 1px solid var(--om-line);
    border-radius: 4px;
    transition: border-color 0.25s var(--om-ease);
  }

  .om-values__card:hover { border-color: var(--om-line-strong); }

  .om-values__morse { font-size: 0.625rem; letter-spacing: 0.22em; }

  .om-values__title {
    margin: 0.25rem 0 0;
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    font-weight: 700;
  }

  .om-values__desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--om-ink-muted);
  }

  /* --- Certifications --- */
  .om-certs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--om-line);
  }

  .om-certs__item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid var(--om-line);
    font-size: 0.9375rem;
    color: var(--om-ink);
  }

  .om-certs__bullet {
    flex: 0 0 auto;
    width: 14px;
    height: 3px;
    border-radius: 99px;
    background: var(--om-accent);
    transform: translateY(-0.2em);
  }

  @media (min-width: 900px) {
    .om-bio { grid-template-columns: 4fr 8fr; }
  }
</style>
