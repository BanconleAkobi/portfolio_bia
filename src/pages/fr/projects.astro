---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { t } from '../../i18n/utils';
import { projects, categoryKey } from '../../data/projects';

const lang = 'fr';
const tr = t(lang);
const projectsTr = tr.projects_page;
const filterLabels: Record<string, string> = projectsTr.filters;

/** Catégories réellement représentées, dans l'ordre déclaré en i18n. */
const presentKeys = new Set(projects.map((p) => categoryKey(p.category)));
const filters = Object.entries(filterLabels).filter(
  ([key]) => key === 'all' || presentKeys.has(key as never)
);
---

<BaseLayout
  lang={lang}
  title={projectsTr.title}
  description="Tous les projets de Banconlé AKOBI : SaaS, cybersécurité, full-stack, IA, infrastructure."
>
  <PageHero eyebrow={projectsTr.subtitle} title={projectsTr.title} signature="projets" />

  <div class="om-section">
    <div class="om-filters" role="group" aria-label="Filtrer les projets par catégorie">
      {filters.map(([key, label], i) => (
        <button
          type="button"
          class:list={['om-filters__btn', i === 0 && 'is-active']}
          data-filter={key}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {label}
        </button>
      ))}
    </div>

    <div class="om-grid gsap-stagger" id="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>

    <p class="om-empty" id="no-results" hidden aria-live="polite">
      <span class="mono">// aucun projet dans cette catégorie</span>
    </p>
  </div>
</BaseLayout>

<style>
  .om-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .om-filters__btn {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.625rem 0.9rem;
    min-height: 44px;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid var(--om-line);
    background: transparent;
    color: var(--om-ink-muted);
    transition: border-color 0.25s var(--om-ease), color 0.25s var(--om-ease), background-color 0.25s var(--om-ease);
  }

  .om-filters__btn:hover {
    border-color: var(--om-line-strong);
    color: var(--om-ink);
  }

  .om-filters__btn.is-active {
    background: var(--om-ink);
    border-color: var(--om-ink);
    color: var(--om-on-ink);
  }

  .om-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(0.875rem, 2vw, 1.5rem);
  }

  .om-empty {
    text-align: center;
    padding: 3rem 1rem;
  }
</style>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('.om-filters__btn');
    var cards = document.querySelectorAll('.om-card');
    var empty = document.getElementById('no-results');

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');

        var filter = btn.dataset.filter;
        var visible = 0;

        cards.forEach(function (card) {
          var show = filter === 'all' || card.dataset.category === filter;
          card.hidden = !show;
          if (show) visible++;
        });

        if (empty) empty.hidden = visible > 0;
      });
    });
  })();
</script>
