---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import MorseMark from '../../components/MorseMark.astro';
import { t } from '../../i18n/utils';

const lang = 'en';
const tr = t(lang);
const contact = tr.contact_page;

const details = [
  { label: contact.email_label, value: 'ingenieurbanconle@gmail.com', href: 'mailto:ingenieurbanconle@gmail.com' },
  { label: contact.location_label, value: contact.location },
  { label: 'LinkedIn', value: 'linkedin.com/in/banconlé-akobi', href: 'https://www.linkedin.com/in/banconl%C3%A9-akobi-a88940273' },
  { label: 'GitHub', value: 'github.com/BanconleAkobi', href: 'https://github.com/BanconleAkobi' },
  { label: 'LanceOS', value: 'lanceos.eu', href: 'https://lanceos.eu' },
];
---

<BaseLayout
  lang={lang}
  title={contact.title}
  description="Contact Banconlé AKOBI: freelance work, apprenticeships, tech projects."
>
  <PageHero eyebrow={contact.subtitle} title={contact.title} signature="contact" />

  <div class="om-section om-contact-page">
    <div class="om-contact-page__info gsap-reveal">
      <p class="om-contact-page__intro">{contact.intro}</p>

      <dl class="om-contact-page__details">
        {details.map((item) => (
          <div class="om-contact-page__row">
            <dt class="om-eyebrow">{item.label}</dt>
            <dd>
              {item.href ? (
                <a
                  href={item.href}
                  class="link-underline"
                  target={item.href.startsWith('mailto:') ? undefined : '_blank'}
                  rel={item.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                >
                  {item.value}
                </a>
              ) : (
                <span>{item.value}</span>
              )}
            </dd>
          </div>
        ))}
      </dl>

      <div class="om-rule om-contact-page__sign">
        <MorseMark word="transmission" />
        <span class="om-rule__line" aria-hidden="true"></span>
      </div>
    </div>

    <div class="om-contact-page__form gsap-reveal">
      <ContactForm lang={lang} idPrefix="page-contact" />
    </div>
  </div>
</BaseLayout>

<style>
  .om-contact-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .om-contact-page__intro {
    font-size: 1.0625rem;
    line-height: 1.65;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 46ch;
  }

  .om-contact-page__details {
    display: grid;
    gap: 1.5rem;
    margin: 0 0 clamp(1.75rem, 4vw, 2.75rem);
  }

  .om-contact-page__row {
    display: grid;
    gap: 0.35rem;
  }

  .om-contact-page__row dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--om-ink-muted);
    word-break: break-word;
  }

  .om-contact-page__row a {
    color: var(--om-ink);
    transition: color 0.25s var(--om-ease);
  }

  .om-contact-page__row a:hover { color: var(--om-accent-ink); }

  @media (min-width: 900px) {
    .om-contact-page { grid-template-columns: 5fr 7fr; }
    .om-contact-page__form { position: sticky; top: 6rem; }
  }
</style>
