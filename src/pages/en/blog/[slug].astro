---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MorseMark from '../../../components/MorseMark.astro';
import { blogPosts } from '../../../data/blog';

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = 'en';
const dateFormatted = new Date(post.date).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

/** Rendu minimal du markdown utilisé dans les articles : paragraphes et gras. */
const html = post.contentEn
  .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
  .split(/\n\n+/)
  .map((block) => `<p>${block.replace(/\n/g, '<br />')}</p>`)
  .join('');
---

<BaseLayout lang={lang} title={post.titleEn} description={post.excerptEn}>
  <article class="om-article">
    <header class="om-article__head">
      <div class="om-article__meta">
        <span>{post.categoryEn}</span>
        <time datetime={post.date}>{dateFormatted}</time>
      </div>
      <h1 class="om-article__title">{post.titleEn}</h1>
      <p class="om-article__excerpt">{post.excerptEn}</p>
      <div class="om-rule om-article__rule">
        <span class="om-rule__line" aria-hidden="true"></span>
        <MorseMark word={post.categoryEn} />
      </div>
    </header>

    <div class="om-article__body">
      <div class="om-prose" set:html={html} />

      <footer class="om-article__footer">
        <a href="/en/blog" class="om-btn--ghost">
          <span aria-hidden="true">&larr;</span>
          Back to the blog
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .om-article__head {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 7vw, 5rem) var(--om-gutter) clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--om-line);
  }

  .om-article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--om-ink-muted);
  }

  .om-article__title {
    margin: 1rem 0 1.25rem;
    font-size: clamp(1.9rem, 5vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 800;
    text-wrap: pretty;
  }

  .om-article__excerpt {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--om-ink-muted);
  }

  .om-article__rule { margin-top: 1.5rem; }

  .om-article__body {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) var(--om-gutter);
  }

  .om-prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--om-ink-muted);
    margin-bottom: 1.375rem;
  }

  .om-prose :global(strong) {
    color: var(--om-ink);
    font-weight: 700;
  }

  .om-prose :global(em) {
    font-family: var(--font-serif);
    font-style: italic;
  }

  .om-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--om-accent-ink);
    background: var(--om-surface-soft);
    border-radius: 3px;
    padding: 0.15em 0.4em;
  }

  .om-article__footer {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--om-line);
  }
</style>
