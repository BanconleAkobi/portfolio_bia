---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { t } from '../../../i18n/utils';
import { blogPosts } from '../../../data/blog';

const lang = 'en';
const tr = t(lang);
const blog = tr.blog_page;

const [featured, ...rest] = blogPosts;
---

<BaseLayout
  lang={lang}
  title={blog.title}
  description="Blog by Banconlé AKOBI: cybersecurity, web development, cloud, career."
>
  <PageHero eyebrow={blog.subtitle} title={blog.title} signature="blog" />

  <div class="om-section">
    <div class="om-blog-grid gsap-stagger">
      {featured && (
        <BlogCard
          title={featured.titleEn}
          category={featured.categoryEn}
          date={featured.date}
          excerpt={featured.excerptEn}
          slug={featured.slug}
          lang={lang}
          featured={true}
        />
      )}
      {rest.map((post) => (
        <BlogCard
          title={post.titleEn}
          category={post.categoryEn}
          date={post.date}
          excerpt={post.excerptEn}
          slug={post.slug}
          lang={lang}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .om-blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: clamp(0.875rem, 2vw, 1.5rem);
  }
</style>
