---
import type { Project } from '../data/projects';
import { categoryKey } from '../data/projects';
import type { Lang } from '../i18n/utils';
import { t } from '../i18n/utils';
import MorseMark from './MorseMark.astro';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const tr = t(lang);
const filterLabels: Record<string, string> = tr.projects_page.filters;

const key = categoryKey(project.category);
const title = lang === 'fr' ? project.title : project.titleEn;
const description = lang === 'fr' ? project.description : project.descriptionEn;
const categoryLabel = filterLabels[key] ?? project.category;
---

<article class="om-card gsap-item" data-category={key}>
  <div class="om-card__shot">
    {project.image ? (
      <img
        src={project.image}
        alt={title}
        loading="lazy"
        decoding="async"
        width="800"
        height="450"
      />
    ) : (
      <span class="om-card__placeholder" aria-hidden="true">{title}</span>
    )}
  </div>

  <div class="om-card__body">
    <div class="om-card__meta">
      <span>{categoryLabel}</span>
      <MorseMark word={title.slice(0, 2)} class="om-card__morse" />
    </div>

    <h3 class="om-card__title">{title}</h3>
    <p class="om-card__desc">{description}</p>

    <ul class="om-card__stack" aria-label={lang === 'fr' ? 'Technologies utilisées' : 'Technologies used'}>
      {project.stack.map((tech) => <li>{tech}</li>)}
    </ul>

    <div class="om-card__links">
      {project.github && !project.repoEmpty && (
        <a
          href={project.github}
          class="om-card__link link-underline"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={lang === 'fr' ? `Code source de ${title} sur GitHub` : `Source code for ${title} on GitHub`}
        >
          {tr.projects_page.cta_code}
          <span aria-hidden="true">&nbsp;&rarr;</span>
        </a>
      )}
      {project.demo && (
        <a
          href={project.demo}
          class="om-card__link om-card__link--demo link-underline"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={lang === 'fr' ? `Voir ${title} en ligne` : `View ${title} online`}
        >
          {tr.projects_page.cta_demo}
          <span aria-hidden="true">&nbsp;&rarr;</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .om-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--om-line);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.25s var(--om-ease), transform 0.25s var(--om-ease);
  }

  /* Le filtrage masque via l'attribut hidden : il doit battre le display:flex. */
  .om-card[hidden] { display: none; }

  .om-card:hover {
    border-color: var(--om-line-strong);
    transform: translateY(-3px);
  }

  .om-card__shot {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--om-surface-soft);
    border-bottom: 1px solid var(--om-line);
  }

  .om-card__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s var(--om-ease);
  }

  .om-card:hover .om-card__shot img { transform: scale(1.03); }

  .om-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--om-ink-muted);
    opacity: 0.7;
  }

  .om-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    padding: 1.25rem;
  }

  .om-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.375rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--om-ink-muted);
  }

  .om-card__morse { font-size: 0.625rem; letter-spacing: 0.2em; }

  .om-card__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .om-card__desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--om-ink-muted);
  }

  .om-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: auto 0 0;
    padding: 0;
  }

  .om-card__stack li {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--om-ink-muted);
    border: 1px solid var(--om-line);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .om-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .om-card__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--om-ink-muted);
    transition: color 0.25s var(--om-ease);
  }

  .om-card__link:hover { color: var(--om-ink); }
  .om-card__link--demo { color: var(--om-accent-ink); }
</style>
