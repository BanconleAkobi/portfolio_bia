---
import { t, getLocalePath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import MorseMark from './MorseMark.astro';
import TimelineItem from './TimelineItem.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const copy = tr.home.timeline;

/**
 * Même rendu que la page Parcours détaillé : on réutilise le composant au
 * lieu d'entretenir une seconde mise en page qui finissait toujours par
 * diverger de la première.
 */
const timeline = tr.about.timeline;
---

<section class="om-journey" id="parcours">
  <div class="om-rule om-journey__head gsap-reveal">
    <h2 class="om-journey__title">{copy.title}</h2>
    <span class="om-rule__line" aria-hidden="true"></span>
    <MorseMark word={copy.title} />
  </div>

  <ol class="om-journey__list gsap-stagger">
    {timeline.map((item, i) => (
      <TimelineItem
        date={item.date}
        title={item.title}
        place={item.place}
        desc={item.desc}
        index={i}
        logos={'logos' in item ? item.logos : []}
        branches={'branches' in item ? item.branches : []}
      />
    ))}
  </ol>

  <div class="om-journey__more gsap-reveal">
    <a href={getLocalePath(lang, '/about')} class="om-btn--ghost">
      {copy.all}
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<style>
  .om-journey {
    padding: clamp(4rem, 9vw, 8rem) var(--om-gutter);
    max-width: var(--om-shell);
    margin: 0 auto;
  }

  .om-journey__head {
    margin-bottom: clamp(1.875rem, 4vw, 3.25rem);
  }

  .om-journey__title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
    flex: 0 0 auto;
  }

  .om-journey__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* La dernière ligne du parcours s'arrête net : il faut de l'air avant
     le bouton, sinon il se colle au texte. */
  .om-journey__more {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
</style>
