---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Clés des organisations, dans l'ordre d'affichage. */
  keys?: string[];
}

const { keys = [] } = Astro.props;

/**
 * Logos des écoles, entreprises et plateformes qui jalonnent le parcours.
 *
 * Pour en ajouter un : déposer le fichier dans src/assets/logos/ sous la clé
 * utilisée ici, quelle que soit l'extension. Astro le redimensionne au build.
 * Une clé sans fichier n'affiche rien, la ligne reste lisible sans lui.
 *
 * Les logos s'affichent en couleur, sans cadre : ils doivent être lisibles
 * du premier coup d'œil, pas au survol.
 *
 * `tone: 'light'` signale un tracé clair sur transparent, illisible sur le
 * fond crème. Ceux-là seulement reçoivent une pastille sombre. Mesuré sur le
 * fond de page, Hack The Box tombe à 1,2:1 sans elle.
 */
const ORGS: Record<string, { name: string; tone?: 'light' }> = {
  insa: { name: 'INSA Hauts-de-France' },
  uphf: { name: 'UPHF' },
  magicrecycle: { name: 'MagicRecycle' },
  easydo: { name: 'EasyDo Digital Technologies' },
  vinci: { name: 'VINCI' },
  lanceos: { name: 'LanceOS' },
  tryhackme: { name: 'TryHackMe' },
  hackthebox: { name: 'Hack The Box', tone: 'light' },
};

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/logos/*.{png,jpg,jpeg,webp,svg,avif}',
  { eager: true }
);

function findLogo(key: string): ImageMetadata | null {
  const match = Object.entries(files).find(([path]) => path.split('/').pop()?.split('.')[0] === key);
  return match ? match[1].default : null;
}

const logos = keys
  .map((key) => ({ key, org: ORGS[key], src: findLogo(key) }))
  .filter((logo) => logo.org && logo.src);
---

{logos.length > 0 && (
  <span class="om-orglogos">
    {logos.map((logo) => (
      <span class:list={['om-orglogo', logo.org.tone && `om-orglogo--${logo.org.tone}`]}>
        {logo.src!.format === 'svg' ? (
          /* Un SVG est déjà plus léger et plus net que n'importe quel rendu
             matriciel : on le sert tel quel, sans passer par sharp. */
          <img
            src={logo.src!.src}
            alt={logo.org.name}
            width={logo.src!.width}
            height={logo.src!.height}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Image
            src={logo.src!}
            alt={logo.org.name}
            width={160}
            densities={[1, 2]}
            format="webp"
            quality={80}
            loading="lazy"
            decoding="async"
          />
        )}
      </span>
    ))}
  </span>
)}

<style>
  .om-orglogos {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    vertical-align: middle;
  }

  .om-orglogo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
  }

  /* Seul cas où un fond est nécessaire : un tracé clair sur fond transparent. */
  .om-orglogo--light {
    height: 1.75rem;
    padding: 0.25rem 0.45rem;
    background: var(--om-ink);
    border-radius: 4px;
  }

  .om-orglogo :global(img) {
    height: 100%;
    width: auto;
    max-width: 6rem;
    object-fit: contain;
  }
</style>
