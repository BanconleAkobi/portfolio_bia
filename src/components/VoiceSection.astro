---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import MorseMark from './MorseMark.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const voice = tr.home.voice;

/**
 * Trois moments, trois petits blocs de vignettes. Les fichiers vivent dans
 * src/assets/voix/ : Astro les redimensionne et les convertit en webp au build,
 * ce que public/ ne permet pas. Le préfixe du nom de fichier fait le
 * regroupement, ajouter une photo à un groupe se réduit donc à la déposer là.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/voix/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);

function group(prefix: string): ImageMetadata[] {
  return Object.entries(files)
    .filter(([path]) => path.includes(`/${prefix}-`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
}

/**
 * `focus` cadre le recadrage carré : les portraits ont le visage haut dans
 * l'image, les photos de groupe l'ont au milieu. C'est de la mise en page,
 * donc ça reste ici et pas dans les fichiers de traduction.
 */
const groups = [
  { key: 'ecole', images: group('parlerecole'), focus: '28%' },
  { key: 'insahdf', images: group('insahdf'), focus: '34%' },
  { key: 'finale', images: group('finale'), focus: '46%' },
]
  .map((g) => ({ ...g, ...voice.groups[g.key] }))
  .filter((g) => g.images.length > 0);
---

<section class="om-voice om-inked" id="voix">
  <div class="om-voice__grid">
    <div class="om-voice__text">
      <div class="om-rule om-voice__eyebrow">
        <MorseMark word={voice.eyebrow} />
        <span class="om-voice__eyebrow-word">{voice.eyebrow}</span>
      </div>

      <h2 class="om-voice__title">
        {voice.title_lead} <em class="om-serif">{voice.title_accent}</em>
      </h2>

      <div class="om-voice__body">
        <p class="om-voice__lead">{voice.body}</p>

        <blockquote class="om-voice__quote">
          <p>{tr.quote.text}</p>
        </blockquote>
        <p class="om-voice__source">{tr.quote.author}, {voice.quote_source}</p>
      </div>

      <ul class="om-voice__badges">
        {voice.badges.map((badge: string) => <li>{badge}</li>)}
      </ul>
    </div>

    <div class="om-voice__media">
      {groups.map((g) => (
        <figure class="om-gal">
          <figcaption class="om-gal__head">
            <span class="om-gal__label">{g.label}</span>
            <span class="om-gal__meta">{g.meta}</span>
          </figcaption>

          <div class="om-gal__strip" data-count={g.images.length} style={`--om-focus:${g.focus}`}>
            {g.images.map((img, i) => (
              <div class="om-gal__thumb">
                {/* Vignette d'environ 160px : 220px en 1x, 440px en 2x, rien de plus. */}
                <Image
                  src={img}
                  alt={`${g.alt} (${i + 1})`}
                  width={220}
                  densities={[1, 2]}
                  format="webp"
                  quality={70}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .om-voice {
    padding: clamp(4rem, 9vw, 8rem) var(--om-gutter);
  }

  .om-voice__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 3.4vw, 3.25rem);
    align-items: start;
    max-width: var(--om-shell);
    margin: 0 auto;
  }

  .om-voice__text { min-width: 0; }

  .om-voice__eyebrow {
    margin-bottom: clamp(1.375rem, 3vw, 2.25rem);
  }

  .om-voice__eyebrow-word {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    color: var(--om-on-ink-muted);
  }

  .om-voice__title {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
    font-weight: 800;
    max-width: 18ch;
  }

  .om-voice__body {
    display: grid;
    gap: 1.375rem;
    margin-top: clamp(1.75rem, 3.6vw, 2.75rem);
    max-width: 52ch;
  }

  .om-voice__lead {
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.5;
    color: var(--om-on-ink);
  }

  .om-voice__quote {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--om-accent);
  }

  .om-voice__quote p {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--om-on-ink);
  }

  .om-voice__source {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--om-on-ink-muted);
  }

  .om-voice__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    list-style: none;
    margin: clamp(1.75rem, 3.6vw, 2.5rem) 0 0;
    padding: 0;
  }

  .om-voice__badges li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    border: 1px solid var(--om-on-ink-line);
    border-radius: 999px;
    padding: 0.5rem 0.8rem;
    color: var(--om-on-ink);
  }

  /* --- Blocs de vignettes --- */
  .om-voice__media {
    min-width: 0;
    display: grid;
    gap: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  .om-gal { margin: 0; }

  .om-gal__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.5rem;
  }

  .om-gal__label {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--om-on-ink);
  }

  .om-gal__meta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--om-on-ink-muted);
  }

  /* Autant de colonnes que de photos : deux ou trois selon le groupe. */
  .om-gal__strip {
    display: grid;
    grid-template-columns: repeat(var(--om-cols, 2), 1fr);
    gap: 6px;
  }

  .om-gal__strip[data-count='3'] { --om-cols: 3; }

  .om-gal__thumb {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--om-on-ink-line);
    background: rgba(241, 235, 221, 0.06);
  }

  .om-gal__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--om-focus, 35%);
    transition: transform 0.4s var(--om-ease);
  }

  .om-gal:hover .om-gal__thumb :global(img) { transform: scale(1.04); }

  @media (min-width: 900px) {
    .om-voice__grid {
      grid-template-columns: 7fr 5fr;
    }
  }
</style>
