---
import { t, getLocalePath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import MorseMark from './MorseMark.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);

const navItems = [
  { href: getLocalePath(lang, '/'), label: tr.nav.home },
  { href: getLocalePath(lang, '/about'), label: tr.nav.about },
  { href: getLocalePath(lang, '/projects'), label: tr.nav.projects },
  { href: getLocalePath(lang, '/blog'), label: tr.nav.blog },
  { href: getLocalePath(lang, '/contact'), label: tr.nav.contact },
];
---

<footer class="om-footer">
  <div class="om-footer__inner">
    <div class="om-footer__grid">
      <div class="om-footer__col">
        <p class="om-eyebrow">{tr.footer.nav_title}</p>
        <nav aria-label={lang === 'fr' ? 'Navigation de pied de page' : 'Footer navigation'}>
          {navItems.map((item) => (
            <a href={item.href} class="om-footer__link link-underline">{item.label}</a>
          ))}
        </nav>
      </div>

      <div class="om-footer__col">
        <p class="om-eyebrow">{tr.footer.contact_title}</p>
        <a href="mailto:ingenieurbanconle@gmail.com" class="om-footer__link link-underline">
          ingenieurbanconle@gmail.com
        </a>
        <a href="https://lanceos.eu" class="om-footer__link link-underline" target="_blank" rel="noopener noreferrer">
          lanceos.eu
        </a>
        <p class="om-footer__note">Valenciennes / Versailles, France</p>
      </div>

      <div class="om-footer__col">
        <p class="om-eyebrow">{tr.footer.social_title}</p>
        <a
          href="https://github.com/BanconleAkobi"
          class="om-footer__link link-underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/banconl%C3%A9-akobi-a88940273"
          class="om-footer__link link-underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <div class="om-footer__bottom">
      <p class="om-footer__note">{tr.footer.copyright}</p>
      <MorseMark word="MORSE" />
    </div>
  </div>
</footer>

<style>
  .om-footer {
    border-top: 1px solid var(--om-line);
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .om-footer__inner {
    max-width: var(--om-shell);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--om-gutter) 2rem;
  }

  .om-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .om-footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .om-footer__col nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .om-footer__col .om-eyebrow {
    margin-bottom: 0.35rem;
  }

  .om-footer__link {
    font-size: 0.9375rem;
    color: var(--om-ink-muted);
    transition: color 0.25s var(--om-ease);
  }

  .om-footer__link:hover {
    color: var(--om-ink);
  }

  .om-footer__note {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--om-ink-muted);
  }

  .om-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--om-line);
  }

  @media (min-width: 720px) {
    .om-footer__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }
</style>
