---
import { t, getLocalePath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { publishedPosts } from '../data/blog';
import BlogCard from './BlogCard.astro';
import MorseMark from './MorseMark.astro';

interface Props {
  lang: Lang;
}

const LATEST_POSTS_COUNT = 2;

const { lang } = Astro.props;
const tr = t(lang);
const copy = tr.home.writing;
const latestPosts = publishedPosts.slice(0, LATEST_POSTS_COUNT);
---

<section class="om-writing" id="ecriture">
  <div class="om-writing__head gsap-reveal">
    <h2 class="om-writing__title">{copy.title}</h2>
    <a href={getLocalePath(lang, '/blog')} class="om-writing__all">
      {copy.all} <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <div class="om-writing__body">
    <article class="om-book gsap-reveal">
      <p class="om-book__label">{copy.book_label}</p>
      <MorseMark word={tr.quote.work} class="om-book__morse" />
      <h3 class="om-book__title">{tr.quote.work}</h3>
      <p class="om-book__desc">{copy.book_desc}</p>
      <blockquote class="om-book__quote">
        <p>{tr.quote.text}</p>
      </blockquote>
    </article>

    <div class="om-writing__posts gsap-stagger">
      {latestPosts.map((post) => (
        <BlogCard
          title={lang === 'fr' ? post.title : post.titleEn}
          category={lang === 'fr' ? post.category : post.categoryEn}
          date={post.date}
          excerpt={lang === 'fr' ? post.excerpt : post.excerptEn}
          slug={post.slug}
          lang={lang}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .om-writing {
    padding: clamp(4rem, 9vw, 8rem) var(--om-gutter) 0;
    max-width: var(--om-shell);
    margin: 0 auto;
  }

  .om-writing__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .om-writing__title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
  }

  .om-writing__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--om-ink);
    border-bottom: 1px solid var(--om-accent);
  }

  .om-writing__all:hover { color: var(--om-accent-ink); }

  .om-writing__body {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.875rem, 2vw, 1.25rem);
  }

  .om-book {
    flex: 1 1 22rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--om-line);
    border-radius: 10px;
    background: var(--om-surface);
  }

  .om-book__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--om-ink-muted);
  }

  .om-book__morse { font-size: 0.875rem; }

  .om-book__title {
    margin: 0;
    font-size: clamp(2.75rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .om-book__desc { margin: 0; }

  .om-book__quote {
    margin: auto 0 0;
    padding-left: 1.125rem;
    border-left: 2px solid var(--om-accent);
  }

  .om-book__quote p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--om-ink);
  }

  .om-writing__posts {
    flex: 2 1 32rem;
    min-width: 0;
    display: grid;
    gap: clamp(0.875rem, 2vw, 1.25rem);
  }
</style>
