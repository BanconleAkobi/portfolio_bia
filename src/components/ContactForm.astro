---
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Préfixe d'identifiants, pour que deux formulaires puissent cohabiter. */
  idPrefix?: string;
}

const { lang, idPrefix = 'contact' } = Astro.props;
const tr = t(lang);
const c = tr.contact_page;

const id = (field: string) => `${idPrefix}-${field}`;

/**
 * Envoi via Netlify Forms, sans backend.
 *
 * Le site est généré en statique par Astro : ce formulaire est donc présent
 * tel quel dans le HTML livré, et le bot de build Netlify le détecte au
 * déploiement. Aucun formulaire statique caché supplémentaire n'est nécessaire.
 *
 * Il reste une chose à faire côté dashboard Netlify, une seule fois :
 * Forms > Form notifications > Add notification > Email notification,
 * vers ingenieurbanconle@gmail.com.
 *
 * La soumission part en fetch POST vers l'URL de la page courante, ce qui
 * évite tout rechargement et permet d'afficher un état de succès ou d'erreur.
 */
const FORM_NAME = 'contact';
---

<form
  class="om-form"
  id={id('form')}
  name={FORM_NAME}
  method="POST"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  novalidate
>
  <!-- Requis par Netlify pour rattacher la soumission au bon formulaire -->
  <input type="hidden" name="form-name" value={FORM_NAME} />
  <input type="hidden" name="lang" value={lang} />

  <!-- Piège à robots : invisible et hors du parcours clavier -->
  <p class="om-form__honeypot" aria-hidden="true">
    <label>
      {c.form_honeypot}
      <input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="om-form__row">
    <div class="om-form__field">
      <label class="om-form__label" for={id('name')}>{c.form_name} *</label>
      <input
        type="text"
        id={id('name')}
        name="name"
        class="om-form__input"
        placeholder={c.form_placeholder_name}
        required
        autocomplete="name"
      />
    </div>

    <div class="om-form__field">
      <label class="om-form__label" for={id('email')}>{c.form_email} *</label>
      <input
        type="email"
        id={id('email')}
        name="email"
        class="om-form__input"
        placeholder={c.form_placeholder_email}
        required
        autocomplete="email"
      />
    </div>
  </div>

  <div class="om-form__field">
    <label class="om-form__label" for={id('subject')}>{c.form_subject}</label>
    <input
      type="text"
      id={id('subject')}
      name="subject"
      class="om-form__input"
      placeholder={c.form_placeholder_subject}
      autocomplete="off"
    />
  </div>

  <div class="om-form__field">
    <label class="om-form__label" for={id('message')}>{c.form_message} *</label>
    <textarea
      id={id('message')}
      name="message"
      class="om-form__input om-form__textarea"
      placeholder={c.form_placeholder_message}
      required
      rows="6"
    ></textarea>
  </div>

  <button type="submit" class="om-btn om-form__submit" data-idle={c.form_send} data-sending={c.form_sending}>
    <span data-submit-label>{c.form_send}</span>
    <span class="om-form__submit-morse" aria-hidden="true">.--</span>
  </button>

  <p class="om-form__status" data-status role="status" aria-live="polite" hidden></p>
</form>

<style>
  .om-form {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .om-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .om-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  .om-form__field {
    display: grid;
    gap: 0.5rem;
  }

  .om-form__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--om-ink-muted);
  }

  .om-form__input {
    width: 100%;
    min-height: 48px;
    padding: 0.875rem;
    background: transparent;
    border: 1px solid var(--om-line);
    border-radius: 3px;
    color: var(--om-ink);
    /* 16px minimum : évite le zoom automatique sur iOS */
    font-size: 1rem;
    transition: border-color 0.25s var(--om-ease);
  }

  .om-form__input::placeholder {
    color: var(--om-ink-muted);
    opacity: 0.65;
  }

  .om-form__input:focus {
    border-color: var(--om-accent);
  }

  /* Le rouge n'apparaît qu'après une tentative d'envoi, pas pendant la frappe. */
  .om-form.is-validated .om-form__input:invalid {
    border-color: var(--om-danger);
  }

  .om-form__textarea {
    resize: vertical;
    min-height: 8.75rem;
    line-height: 1.55;
  }

  .om-form__submit {
    justify-self: start;
    align-self: flex-start;
    margin-top: 0.25rem;
  }

  .om-form__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .om-form__submit-morse {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
  }

  .om-form__status {
    margin: 0;
    padding: 0.875rem 1rem;
    border-radius: 3px;
    border: 1px solid currentColor;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .om-form__status[hidden] { display: none; }
  .om-form__status[data-tone='ok'] { color: var(--om-accent-ink); }
  .om-form__status[data-tone='error'] { color: var(--om-danger); }

  @media (min-width: 560px) {
    .om-form__row { grid-template-columns: 1fr 1fr; }
  }
</style>

<script is:inline define:vars={{ formId: id('form'), messages: { ok: c.form_success, error: c.form_error } }}>
  (function () {
    var form = document.getElementById(formId);
    if (!form) return;

    var submit = form.querySelector('.om-form__submit');
    var submitLabel = form.querySelector('[data-submit-label]');
    var status = form.querySelector('[data-status]');

    function show(tone, text) {
      if (!status) return;
      status.dataset.tone = tone;
      status.textContent = text;
      status.hidden = false;
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      form.classList.add('is-validated');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (status) status.hidden = true;

      if (submit) {
        submit.disabled = true;
        if (submitLabel) submitLabel.textContent = submit.dataset.sending || '';
      }

      fetch(window.location.pathname, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString(),
      })
        .then(function (response) {
          if (!response.ok) throw new Error('HTTP ' + response.status);
          form.reset();
          form.classList.remove('is-validated');
          show('ok', messages.ok);
        })
        .catch(function () {
          show('error', messages.error);
        })
        .finally(function () {
          if (submit) {
            submit.disabled = false;
            if (submitLabel) submitLabel.textContent = submit.dataset.idle || '';
          }
        });
    });
  })();
</script>
