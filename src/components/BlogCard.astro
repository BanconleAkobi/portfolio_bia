---
import MorseMark from './MorseMark.astro';

interface Props {
  title: string;
  category: string;
  date: string;
  excerpt: string;
  slug: string;
  lang: 'fr' | 'en';
  featured?: boolean;
}

const { title, category, date, excerpt, slug, lang, featured } = Astro.props;
const href = `/${lang}/blog/${slug}`;
const dateFormatted = new Date(date).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class:list={['om-post', 'gsap-item', featured && 'om-post--featured', featured && 'om-inked']}>
  <div class="om-post__meta">
    <span>{category}</span>
    <time datetime={date}>{dateFormatted}</time>
  </div>

  <h2 class="om-post__title">
    <!-- Le lien couvre toute la carte, tout en restant un lien de titre net. -->
    <a href={href} class="om-post__link">{title}</a>
  </h2>

  <p class="om-post__excerpt">{excerpt}</p>

  <div class="om-post__footer">
    <span class="om-post__more">
      {lang === 'fr' ? "Lire l'article" : 'Read article'}
      <span aria-hidden="true">&nbsp;&rarr;</span>
    </span>
    <MorseMark word={category} class="om-post__morse" />
  </div>
</article>

<style>
  .om-post {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: clamp(1.25rem, 2.4vw, 1.875rem);
    border: 1px solid var(--om-line);
    border-radius: 4px;
    transition: border-color 0.25s var(--om-ease), transform 0.25s var(--om-ease);
  }

  .om-post:hover {
    border-color: var(--om-line-strong);
    transform: translateY(-3px);
  }

  .om-post--featured {
    grid-column: 1 / -1;
    border-color: var(--om-ink);
  }

  .om-post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.375rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--om-ink-muted);
  }

  .om-post--featured .om-post__meta { color: var(--om-on-ink-muted); }

  .om-post__title {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .om-post--featured .om-post__title {
    font-size: clamp(1.5rem, 3.5vw, 2.6rem);
    max-width: 22ch;
  }

  .om-post__link {
    color: var(--om-ink);
    transition: color 0.25s var(--om-ease);
  }

  /* Toute la carte devient cliquable, sans dupliquer le lien pour le clavier. */
  .om-post__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 4px;
  }

  .om-post__link:hover { color: var(--om-accent-ink); }

  .om-post--featured .om-post__link { color: var(--om-on-ink); }

  .om-post__excerpt {
    margin: 0;
    max-width: 60ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--om-ink-muted);
  }

  .om-post--featured .om-post__excerpt { color: var(--om-on-ink-muted); }

  .om-post__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .om-post__more {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--om-accent-ink);
  }

  .om-post__morse { font-size: 0.625rem; letter-spacing: 0.2em; }
</style>
