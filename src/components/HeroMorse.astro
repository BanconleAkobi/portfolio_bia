---
import { t, getLocalePath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { toUnits } from '../lib/morse';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const hero = tr.hero;

/** Le mot qui se décode dans le hero : le titre du livre. */
const WORD = 'MORSE';
const units = toUnits(WORD);
---

<section class="om-hero" id="top" aria-label={hero.subtitle}>
  <div class="om-hero__grid">
    <div class="om-hero__main">
      <!-- Signature morse animée. Purement décorative : la phrase qu'elle
           code est écrite juste en dessous, en clair. -->
      <div class="om-hero__strip" id="om-hero-strip" aria-hidden="true">
        {units.map((u) => (
          <span
            class:list={['om-hero__unit', `om-hero__unit--${u.kind === 'gap' ? 'gap' : u.kind === '-' ? 'dash' : 'dot'}`]}
            data-gap={u.kind === 'gap' ? '' : undefined}
          ></span>
        ))}
      </div>

      <p class="om-hero__decoded" aria-hidden="true">
        {hero.morse_prefix} <span id="om-hero-decoded">{WORD}</span><span class="om-hero__caret" id="om-hero-caret"></span>
        <span class="om-hero__decoded-note">/ {hero.morse_caption}</span>
      </p>
      <p class="om-sr-only">{hero.morse_prefix} {WORD}, {hero.morse_caption}.</p>

      <h1 class="om-hero__title">
        <span class="om-hero__line om-hero__line--1">{hero.line1}</span>
        <span class="om-hero__line om-hero__line--2">{hero.line2}</span>
        <span class="om-hero__line om-hero__line--3">
          <span class="om-hero__lead">{hero.line3_lead}&nbsp;</span><em class="om-serif">{hero.line3_accent}</em>
        </span>
      </h1>

      <div class="om-hero__copy">
        <p class="om-hero__intro">{hero.intro}</p>
        <p class="om-hero__meta">{hero.meta}</p>
      </div>

      <div class="om-hero__actions">
        <a href="#projets" class="om-btn">
          {hero.cta_primary}
          <span class="om-hero__btn-morse" aria-hidden="true">.--</span>
        </a>
        <a href={getLocalePath(lang, '/contact')} class="om-hero__link">{hero.cta_secondary}</a>
      </div>
    </div>

    <div class="om-hero__aside">
      <!-- Emplacement portrait, ratio 4:5 -->
      <figure class="om-hero__portrait">
        <div class="om-frame om-frame--portrait">
          <img
            src="/images/profile.jpg"
            alt={hero.portrait_alt}
            width="1080"
            height="1440"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption class="om-hero__caption">{hero.portrait_caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .om-hero {
    padding: clamp(2rem, 6vw, 5rem) var(--om-gutter) clamp(1.5rem, 4vw, 3rem);
    max-width: var(--om-shell);
    margin: 0 auto;
  }

  .om-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 2.75rem);
    align-items: end;
  }

  .om-hero__main { min-width: 0; }

  /* --- Bande morse --- */
  /* La bande fait 17 signes indivisibles : à taille fixe elle mesurait 410px
     et débordait sur mobile. Chaque signe suit donc la largeur d'écran. */
  .om-hero__strip {
    display: flex;
    align-items: center;
    gap: clamp(3px, 1.1vw, 6px);
    height: clamp(16px, 4vw, 22px);
  }

  .om-hero__unit {
    flex: 0 0 auto;
    height: clamp(6px, 1.7vw, 9px);
    border-radius: 99px;
    background: var(--om-accent);
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .om-hero__unit--dot  { width: clamp(5px, 1.7vw, 9px); }
  .om-hero__unit--dash { width: clamp(16px, 5.8vw, 30px); }
  .om-hero__unit--gap  { width: clamp(8px, 3vw, 16px); background: transparent; }

  /* L'état « éteint » n'existe que si le script prend la main. */
  .om-hero__strip.is-animating .om-hero__unit:not(.is-lit) {
    background: var(--om-line);
  }
  .om-hero__strip.is-animating .om-hero__unit--gap { background: transparent; }
  .om-hero__strip.is-animating .om-hero__unit.is-current { transform: scaleY(1.7); }

  .om-hero__decoded {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    color: var(--om-ink-muted);
    margin: 0.875rem 0 clamp(1.125rem, 3vw, 2.125rem);
  }

  .om-hero__caret {
    display: inline-block;
    width: 0.55em;
    color: var(--om-accent-ink);
  }

  .om-hero__caret.is-on::after { content: '_'; }

  .om-hero__decoded-note { color: var(--om-ink-muted); opacity: 0.75; }

  .om-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* --- Titre ---
     Hiérarchie du plus petit au plus gros :
     « Et surtout, » < « Je code. J'écris. » < « je parle. »
     La conjonction n'est qu'une respiration, elle passe en gris secondaire
     et s'efface. Chaque palier a son propre clamp, aucun n'est dérivé en em,
     pour que le rapport de tailles tienne du mobile au grand écran. */
  .om-hero__title {
    margin: 0;
    letter-spacing: -0.045em;
    font-weight: 800;
  }

  .om-hero__line {
    display: block;
  }

  .om-hero__line--1,
  .om-hero__line--2 {
    font-size: clamp(2rem, 8vw, 6.4rem);
    line-height: 0.86;
  }

  .om-hero__line--1 { animation: om-rise 0.7s var(--om-ease) both; }
  .om-hero__line--2 { animation: om-rise 0.7s var(--om-ease) 0.28s both; }

  .om-hero__line--3 {
    /* Plus d'air que les blocs sans : l'italique serif monte et descend. */
    line-height: 0.98;
    animation: om-pop 0.95s cubic-bezier(0.2, 0.8, 0.2, 1) 0.72s both;
    transform-origin: left bottom;
  }

  .om-hero__lead {
    font-weight: 400;
    font-size: clamp(1.1rem, 3.2vw, 2.3rem);
    /* Le crénage serré est un effet de titre : hors sujet à cette taille. */
    letter-spacing: normal;
    color: var(--om-ink-muted);
    padding-right: 0.4em;
  }

  .om-hero__line--3 .om-serif {
    font-size: clamp(2.9rem, 11.5vw, 9rem);
    line-height: 1.06;
  }

  /* --- Copie --- */
  .om-hero__copy {
    /* Le titre respire avant le texte courant. */
    margin-top: clamp(2.25rem, 5vw, 4.25rem);
    max-width: 46ch;
    display: grid;
    gap: 0.625rem;
  }

  .om-hero__intro {
    margin: 0;
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--om-ink);
  }

  .om-hero__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--om-ink-muted);
  }

  /* --- Actions --- */
  .om-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.125rem;
    margin-top: clamp(1.625rem, 3.5vw, 2.5rem);
  }

  .om-hero__btn-morse {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--om-accent);
  }

  .om-btn:hover .om-hero__btn-morse { color: inherit; }

  .om-hero__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.125rem;
    font-size: 1rem;
    color: var(--om-ink);
    border-bottom: 1px solid var(--om-accent);
    transition: color 0.25s var(--om-ease);
  }

  .om-hero__link:hover { color: var(--om-accent-ink); }

  /* --- Portrait --- */
  .om-hero__aside { min-width: 0; }

  .om-hero__portrait {
    margin: 0;
    max-width: 420px;
  }

  /* .om-frame porte déjà overflow:hidden, l'image est donc rognée aux angles. */
  .om-hero__portrait .om-frame {
    border-radius: 8px;
  }

  .om-hero__caption {
    margin-top: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    color: var(--om-ink-muted);
  }

  @media (min-width: 900px) {
    .om-hero__grid {
      grid-template-columns: 8fr 4fr;
      gap: clamp(1.75rem, 3vw, 2.75rem);
    }

    .om-hero__portrait { margin-left: auto; }
    .om-hero__caption { text-align: right; }
  }
</style>

<script is:inline>
  (function () {
    var strip = document.getElementById('om-hero-strip');
    var out = document.getElementById('om-hero-decoded');
    var caret = document.getElementById('om-hero-caret');
    if (!strip || !out) return;

    var WORD = out.textContent || '';
    var units = Array.prototype.slice.call(strip.children);
    var total = units.length;

    // Mouvement réduit : la bande reste allumée, le mot reste lisible.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    strip.classList.add('is-animating');

    var step = 0;

    function render() {
      var decoded = 0;
      for (var i = 0; i < total; i++) {
        var lit = i < step;
        units[i].classList.toggle('is-lit', lit);
        units[i].classList.toggle('is-current', i === step - 1);
        if (lit && units[i].hasAttribute('data-gap')) decoded++;
      }
      out.textContent = WORD.slice(0, decoded);
    }

    render();

    // Une pause de dix pas en fin de mot avant de recommencer à transmettre.
    setInterval(function () {
      step = step > total + 10 ? 0 : step + 1;
      render();
    }, 155);

    // Le curseur clignote tant que le mot n'est pas entièrement décodé.
    if (caret) {
      var on = false;
      setInterval(function () {
        var complete = (out.textContent || '').length >= WORD.length;
        on = complete ? false : !on;
        caret.classList.toggle('is-on', on);
      }, 520);
    }
  })();
</script>
