---
import { t, getLocalePath, getOtherLang } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import MorseMark from './MorseMark.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const otherLang = getOtherLang(lang);
const currentPath = Astro.url.pathname;
const otherLangPath = currentPath.replace(`/${lang}`, `/${otherLang}`);
const homePath = getLocalePath(lang, '/');

const navItems = [
  { href: getLocalePath(lang, '/about'), label: tr.nav.about },
  { href: getLocalePath(lang, '/projects'), label: tr.nav.projects },
  { href: getLocalePath(lang, '/blog'), label: tr.nav.blog },
];

const contactHref = getLocalePath(lang, '/contact');
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="om-header">
  <div class="om-header__inner">
    <a href={homePath} class="om-logo" aria-label={`${tr.nav.home}, ${tr.hero.name}`}>
      <span class="om-logo__name">Banconlé Akobi</span>
      <MorseMark word="BA" class="om-logo__morse" />
    </a>

    <nav class="om-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      {navItems.map((item) => (
        <a href={item.href} class:list={['om-nav__link', isActive(item.href) && 'is-active']}>
          {item.label}
        </a>
      ))}
      <a href={contactHref} class:list={['om-nav__pill', isActive(contactHref) && 'is-active']}>
        {tr.nav.contact}
      </a>
    </nav>

    <div class="om-header__actions">
      <button
        type="button"
        id="om-theme-toggle"
        class="om-icon-btn"
        aria-label={tr.theme.toggle_aria}
        aria-pressed="false"
      >
        <svg class="om-icon-btn__jour" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="om-icon-btn__nuit" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>

      <a href={otherLangPath} class="om-lang" hreflang={otherLang} aria-label={`${otherLang === 'en' ? 'Switch to English' : 'Passer en français'}`}>
        <span class="om-lang__current">{lang.toUpperCase()}</span>
        <span class="om-lang__sep" aria-hidden="true">/</span>
        <span class="om-lang__other">{otherLang.toUpperCase()}</span>
      </a>

      <button
        type="button"
        id="om-burger"
        class="om-burger"
        aria-label={lang === 'fr' ? 'Ouvrir le menu' : 'Open menu'}
        aria-expanded="false"
        aria-controls="om-mobile-menu"
      >
        <span class="om-burger__line"></span>
        <span class="om-burger__line"></span>
      </button>
    </div>
  </div>

  <div id="om-mobile-menu" class="om-mobile" hidden>
    <nav class="om-mobile__nav" aria-label={lang === 'fr' ? 'Navigation mobile' : 'Mobile navigation'}>
      <a href={homePath} class="om-mobile__link">{tr.nav.home}</a>
      {navItems.map((item) => (
        <a href={item.href} class="om-mobile__link">{item.label}</a>
      ))}
      <a href={contactHref} class="om-mobile__link">{tr.nav.contact}</a>
      <MorseMark word="MORSE" class="om-mobile__morse" />
    </nav>
  </div>
</header>

<style>
  .om-header {
    position: sticky;
    top: 0;
    z-index: 900;
    background: var(--om-bg-veil);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--om-line);
  }

  .om-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--om-shell);
    margin: 0 auto;
    padding: 0.75rem var(--om-gutter);
  }

  .om-logo {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    min-width: 0;
  }

  .om-logo__name {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--om-ink);
    white-space: nowrap;
  }

  .om-logo__morse {
    font-size: 0.625rem;
    letter-spacing: 0.32em;
  }

  .om-nav {
    display: none;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  .om-nav__link,
  .om-nav__pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--om-ink-muted);
    padding: 0.75rem 0;
    transition: color 0.25s var(--om-ease);
  }

  .om-nav__link:hover,
  .om-nav__link.is-active {
    color: var(--om-ink);
  }

  .om-nav__pill {
    color: var(--om-ink);
    border: 1px solid var(--om-ink);
    border-radius: 999px;
    padding: 0.6rem 1rem;
    transition: background-color 0.25s var(--om-ease), color 0.25s var(--om-ease);
  }

  .om-nav__pill:hover,
  .om-nav__pill.is-active {
    background: var(--om-ink);
    color: var(--om-on-ink);
  }

  .om-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .om-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    color: var(--om-ink-muted);
    cursor: pointer;
    border-radius: 999px;
    transition: color 0.25s var(--om-ease), background-color 0.25s var(--om-ease);
  }

  .om-icon-btn:hover {
    color: var(--om-ink);
    background: var(--om-surface-soft);
  }

  /* En thème jour, on propose la nuit, et inversement. */
  .om-icon-btn__jour { display: none; }
  .om-icon-btn__nuit { display: block; }
  :global(:root[data-theme='nuit']) .om-icon-btn__jour { display: block; }
  :global(:root[data-theme='nuit']) .om-icon-btn__nuit { display: none; }

  .om-lang {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 44px;
    padding: 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .om-lang__current { color: var(--om-accent-ink); }
  .om-lang__sep { color: var(--om-line-strong); }
  .om-lang__other {
    color: var(--om-ink-muted);
    transition: color 0.25s var(--om-ease);
  }
  .om-lang:hover .om-lang__other { color: var(--om-ink); }

  .om-burger {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  .om-burger__line {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--om-ink);
    transition: transform 0.3s var(--om-ease), opacity 0.3s var(--om-ease);
  }

  .om-burger.is-open .om-burger__line:nth-child(1) { transform: translateY(3.75px) rotate(45deg); }
  .om-burger.is-open .om-burger__line:nth-child(2) { transform: translateY(-3.75px) rotate(-45deg); }

  .om-mobile {
    border-top: 1px solid var(--om-line);
    background: var(--om-bg);
    padding: 1.5rem var(--om-gutter) 2.5rem;
  }

  .om-mobile[hidden] { display: none; }

  .om-mobile__nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: var(--om-shell);
    margin: 0 auto;
  }

  .om-mobile__link {
    font-size: clamp(1.5rem, 7vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--om-ink);
    padding: 0.5rem 0;
    min-height: 48px;
    display: flex;
    align-items: center;
  }

  .om-mobile__link:hover { color: var(--om-accent-ink); }

  .om-mobile__morse {
    margin-top: 1.25rem;
    font-size: 0.6875rem;
  }

  @media (min-width: 860px) {
    .om-nav { display: flex; }
    .om-burger { display: none; }
    .om-mobile { display: none !important; }
    .om-header__actions { gap: 0.75rem; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;

    // --- Thème jour / nuit ---
    var toggle = document.getElementById('om-theme-toggle');
    var meta = document.getElementById('theme-color-meta');

    function syncToggle() {
      var isNuit = root.dataset.theme === 'nuit';
      if (toggle) toggle.setAttribute('aria-pressed', String(isNuit));
      if (meta) meta.setAttribute('content', isNuit ? '#16110D' : '#F1EBDD');
    }
    syncToggle();

    toggle && toggle.addEventListener('click', function () {
      var next = root.dataset.theme === 'nuit' ? 'jour' : 'nuit';
      root.dataset.theme = next;
      try { localStorage.setItem('om-theme', next); } catch (e) { /* stockage indisponible */ }
      syncToggle();
    });

    // --- Menu mobile ---
    var burger = document.getElementById('om-burger');
    var menu = document.getElementById('om-mobile-menu');

    function closeMenu() {
      if (!burger || !menu) return;
      burger.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
    }

    burger && burger.addEventListener('click', function () {
      if (!menu) return;
      var willOpen = menu.hidden;
      burger.classList.toggle('is-open', willOpen);
      burger.setAttribute('aria-expanded', String(willOpen));
      menu.hidden = !willOpen;
    });

    menu && menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMenu();
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth >= 860) closeMenu();
    });
  })();
</script>
