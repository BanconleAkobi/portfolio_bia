---
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { toMorse } from '../lib/morse';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const items: string[] = tr.about.certifications;

/** Signature morse dérivée des trois premières lettres du libellé. */
const sign = (label: string) => toMorse(label.replace(/[^\p{L}\s]/gu, '').trim().slice(0, 3));
---

<section class="om-creds" id="preuves">
  <h2 class="om-creds__title gsap-reveal">{tr.home.certifications.title}</h2>

  <ul class="om-creds__grid gsap-stagger">
    {items.map((item, i) => (
      /* Respiration visuelle : une carte sur cinq passe en encre. */
      <li class:list={['om-creds__card', 'gsap-item', i % 5 === 4 && 'om-inked']}>
        <span class="om-morse om-creds__morse" aria-hidden="true">{sign(item)}</span>
        <span class="om-creds__label">{item}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .om-creds {
    padding: 0 var(--om-gutter) clamp(4rem, 9vw, 8rem);
    max-width: var(--om-shell);
    margin: 0 auto;
  }

  .om-creds__title {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
  }

  .om-creds__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .om-creds__card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-height: 9.375rem;
    padding: 1.375rem;
    border: 1px solid var(--om-line);
    border-radius: 4px;
    transition: border-color 0.25s var(--om-ease);
  }

  .om-creds__card:hover { border-color: var(--om-line-strong); }

  .om-creds__morse {
    font-size: 0.625rem;
    letter-spacing: 0.24em;
  }

  .om-creds__label {
    margin-top: auto;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--om-ink);
    text-wrap: pretty;
  }

  /* Le fond et l'accent viennent de la classe .om-inked, qui les recalcule
     selon le thème. Ici on ne fait qu'ajuster la couleur du libellé. */
  .om-creds__card.om-inked { border-color: var(--om-ink); }
  .om-creds__card.om-inked .om-creds__label { color: var(--om-on-ink); }
</style>
