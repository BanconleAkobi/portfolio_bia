---
import OrgLogo from './OrgLogo.astro';

interface Props {
  date: string;
  title: string;
  place: string;
  desc: string;
  index: number;
  /** Clés des organisations à illustrer sur la ligne. */
  logos?: string[];
}

const { date, title, place, desc, logos = [] } = Astro.props;
---

<li class="om-tl gsap-item">
  <span class="om-tl__marker" aria-hidden="true">
    <span class="om-tl__dot"></span>
    <span class="om-tl__line"></span>
  </span>
  <div class="om-tl__content">
    <span class="om-tl__date">{date}</span>
    <h3 class="om-tl__title">{title}</h3>
    <p class="om-tl__place">
      <OrgLogo keys={logos} />
      <span>{place}</span>
    </p>
    <p class="om-tl__desc">{desc}</p>
  </div>
</li>

<style>
  .om-tl {
    display: grid;
    grid-template-columns: 0.75rem 1fr;
    gap: 1.25rem;
    list-style: none;
  }

  .om-tl__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.4rem;
  }

  .om-tl__dot {
    width: 9px;
    height: 9px;
    border-radius: 99px;
    background: var(--om-accent);
    flex-shrink: 0;
    transition: transform 0.25s var(--om-ease);
  }

  .om-tl:hover .om-tl__dot { transform: scale(1.4); }

  .om-tl__line {
    flex: 1;
    width: 1px;
    background: var(--om-line);
    margin-top: 0.5rem;
    min-height: 2.5rem;
  }

  .om-tl:last-child .om-tl__line { display: none; }

  .om-tl__content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-bottom: 2.25rem;
  }

  .om-tl__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--om-accent-ink);
  }

  .om-tl__title {
    margin: 0.15rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 600;
  }

  .om-tl__place {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--om-ink-muted);
  }

  .om-tl__desc {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--om-ink-muted);
  }
</style>
