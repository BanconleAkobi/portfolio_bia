---
import OrgLogo from './OrgLogo.astro';

export interface TimelineEntry {
  date: string;
  title: string;
  place: string;
  desc: string;
  logos?: string[];
}

interface Props extends TimelineEntry {
  index: number;
  /**
   * Étapes rattachées à cette ligne. La formation porte ainsi les contrats
   * et le stage qui se déroulent pendant elle, dans une seconde colonne
   * séparée par un filet, au lieu de les éparpiller dans la liste.
   */
  branches?: TimelineEntry[];
}

const { date, title, place, desc, logos = [], branches = [] } = Astro.props;
const hasBranches = branches.length > 0;
---

<li class:list={['om-tl', hasBranches && 'om-tl--split']}>
  <span class="om-tl__marker" aria-hidden="true">
    <span class="om-tl__dot"></span>
    <span class="om-tl__line"></span>
  </span>

  <div class="om-tl__body">
    <div class="om-tl__content gsap-item">
      <span class="om-tl__date">{date}</span>
      <h3 class="om-tl__title">{title}</h3>
      <p class="om-tl__place">
        <OrgLogo keys={logos} />
        <span>{place}</span>
      </p>
      <p class="om-tl__desc">{desc}</p>
    </div>

    {hasBranches && (
      <ol class="om-tl__branches">
        {branches.map((branch) => (
          <li class="om-tl__branch gsap-item">
            <span class="om-tl__date">{branch.date}</span>
            <h4 class="om-tl__branch-title">{branch.title}</h4>
            <p class="om-tl__place">
              <OrgLogo keys={branch.logos ?? []} />
              <span>{branch.place}</span>
            </p>
            <p class="om-tl__desc">{branch.desc}</p>
          </li>
        ))}
      </ol>
    )}
  </div>
</li>

<style>
  .om-tl {
    display: grid;
    grid-template-columns: 0.75rem 1fr;
    gap: 1.25rem;
    list-style: none;
  }

  .om-tl__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.4rem;
  }

  .om-tl__dot {
    width: 9px;
    height: 9px;
    border-radius: 99px;
    background: var(--om-accent);
    flex-shrink: 0;
    transition: transform 0.25s var(--om-ease);
  }

  .om-tl:hover .om-tl__dot { transform: scale(1.4); }

  .om-tl__line {
    flex: 1;
    width: 1px;
    background: var(--om-line);
    margin-top: 0.5rem;
    min-height: 2.5rem;
  }

  .om-tl:last-child .om-tl__line { display: none; }

  .om-tl__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-bottom: 2.25rem;
  }

  .om-tl__content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .om-tl__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--om-accent-ink);
  }

  .om-tl__title {
    margin: 0.15rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 600;
  }

  .om-tl__place {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--om-ink-muted);
  }

  .om-tl__desc {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--om-ink-muted);
  }

  /* --- Seconde colonne : les étapes vécues pendant la formation --- */
  .om-tl__branches {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .om-tl__branch {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    /* Chaque étape s'accroche au filet qui sépare les deux colonnes. */
    position: relative;
    padding-left: 1.25rem;
  }

  .om-tl__branch::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.75rem;
    height: 1px;
    background: var(--om-line);
  }

  .om-tl__branch-title {
    margin: 0.15rem 0 0;
    font-size: 1.05rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--om-ink);
  }

  @media (min-width: 900px) {
    /* La formation à gauche, ce qu'elle a contenu à droite, un filet entre
       les deux. En dessous de 900px les colonnes s'empilent et le filet
       passe à gauche des étapes, ce qui garde la hiérarchie lisible. */
    .om-tl--split .om-tl__body {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      align-items: start;
    }

    .om-tl--split .om-tl__branches {
      border-left: 1px solid var(--om-line);
      padding-left: clamp(1.25rem, 2.5vw, 2rem);
    }

    .om-tl--split .om-tl__branch {
      padding-left: 0;
    }

    .om-tl--split .om-tl__branch::before {
      display: none;
    }
  }
</style>
