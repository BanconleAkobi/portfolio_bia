---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, getAlternatePath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: 'fr' | 'en';
}

const {
  title,
  description,
  ogImage = '/images/og-image.png',
  lang: propLang
} = Astro.props;

const lang = propLang || getLang(new URL(Astro.request.url));

const defaultTitle = lang === 'fr'
  ? 'Banconlé AKOBI, ingénieur informatique et cybersécurité'
  : 'Banconlé AKOBI, computer science and cybersecurity engineer';
const defaultDesc = lang === 'fr'
  ? "Portfolio de Banconlé AKOBI : ingénieur informatique et cybersécurité en alternance, 5e année à l'INSA, fondateur de LanceOS. Cybersécurité, full-stack, cloud, éloquence."
  : "Portfolio of Banconlé AKOBI: computer science and cybersecurity engineer on a work-study programme, 5th year at INSA, founder of LanceOS. Cybersecurity, full-stack, cloud, public speaking.";

const pageTitle = title ? `${title} · Banconlé AKOBI` : defaultTitle;
const pageDesc = description || defaultDesc;

/**
 * Le domaine vient de `site` dans astro.config.mjs, jamais d'une constante
 * locale : un canonical qui désigne un autre domaine que celui servi empêche
 * l'indexation, et c'est exactement ce qui s'était produit avec l'ancien nom.
 */
const siteUrl = Astro.site?.origin ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const frUrl = new URL(getAlternatePath(Astro.url.pathname, 'fr'), Astro.site).href;
const enUrl = new URL(getAlternatePath(Astro.url.pathname, 'en'), Astro.site).href;
---

<!DOCTYPE html>
<html lang={lang} class="no-js" data-theme="jour">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#F1EBDD" id="theme-color-meta" />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

  <!-- Canonical + alternates -->
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="fr" href={frUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={frUrl} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!--
    Polices variables : Bricolage Grotesque (axes opsz + wght en une seule
    ressource), Instrument Serif pour l'italique de signature, JetBrains Mono
    pour le morse et les micro-libellés.
  -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <!-- Thème appliqué avant peinture, pour éviter tout flash -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      root.classList.remove('no-js');
      try {
        var saved = localStorage.getItem('om-theme');
        if (saved === 'nuit' || saved === 'jour') root.dataset.theme = saved;
      } catch (e) { /* stockage indisponible : on garde « jour » */ }
      var meta = document.getElementById('theme-color-meta');
      if (meta) meta.setAttribute('content', root.dataset.theme === 'nuit' ? '#16110D' : '#F1EBDD');
    })();
  </script>

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Banconlé AKOBI",
    "jobTitle": lang === 'fr' ? "Ingénieur informatique et cybersécurité" : "Computer science and cybersecurity engineer",
    "url": siteUrl,
    "sameAs": [
      "https://www.linkedin.com/in/banconl%C3%A9-akobi-a88940273",
      "https://github.com/BanconleAkobi",
      "https://lanceos.eu"
    ],
    "email": "ingenieurbanconle@gmail.com",
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "INSA Hauts-de-France"
    }
  })} />
</head>
<body>
  <a href="#contenu" class="om-skip">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>

  <Header lang={lang} />

  <main id="contenu">
    <slot />
  </main>

  <Footer lang={lang} />

  <!-- GSAP -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>

  <!-- Révélations au scroll -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Mouvement réduit ou GSAP indisponible : on affiche tout, tout de suite.
      if (reduced || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        document.querySelectorAll('.gsap-reveal, .gsap-item').forEach(function (el) {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
        document.querySelectorAll('.gsap-clip').forEach(function (el) {
          el.style.clipPath = 'none';
        });
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      gsap.utils.toArray('.gsap-reveal').forEach(function (el) {
        gsap.fromTo(el,
          { opacity: 0, y: 24 },
          {
            opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
            scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' }
          }
        );
      });

      document.querySelectorAll('.gsap-stagger').forEach(function (container) {
        var children = container.querySelectorAll('.gsap-item');
        if (children.length === 0) return;
        gsap.fromTo(children,
          { opacity: 0, y: 24 },
          {
            opacity: 1, y: 0, duration: 0.6, stagger: 0.08, ease: 'power3.out',
            scrollTrigger: { trigger: container, start: 'top 85%', toggleActions: 'play none none none' }
          }
        );
      });

      gsap.utils.toArray('.gsap-clip').forEach(function (el) {
        gsap.fromTo(el,
          { clipPath: 'inset(100% 0 0 0)' },
          {
            clipPath: 'inset(0% 0 0 0)', duration: 1.1, ease: 'power4.out',
            scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' }
          }
        );
      });
    });
  </script>

  <style is:global>
    .om-skip {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 9999;
      padding: 0.85rem 1.25rem;
      background: var(--om-ink);
      color: var(--om-on-ink);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      border-radius: 0 0 4px 0;
    }

    .om-skip:focus {
      left: 0;
    }
  </style>
</body>
</html>
